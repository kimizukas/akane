# Existing bot configuration
API_ID=
API_HASH=
BOT_TOKEN=
MONGO_URL=
LOGGER_ID=
OWNER_ID=
SESSION=

# Optional assistant accounts
SESSION2=
SESSION3=

# FastAPI
MUSIC_API_HOST=127.0.0.1
MUSIC_API_PORT=8088
MUSIC_API_DEBUG=false

# Telegram authentication
TELEGRAM_AUTH_MAX_AGE=3600

# Access token: 15 minutes
MUSIC_ACCESS_TOKEN_TTL=900

# Refresh token: 30 days
MUSIC_REFRESH_TOKEN_TTL=2592000

# Use a new random secret with at least 32 characters.
# Generate it separately; do not commit the real value to GitHub.
MINIAPP_JWT_SECRET=

# Upload
MUSIC_UPLOAD_DIR=
MUSIC_MAX_UPLOAD_SIZE=5242880
MUSIC_UPLOAD_COOLDOWN=8

# Optional Gemini integration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Leave empty for same-origin hosting.
# Add exact trusted origins only if a separate frontend domain is used.
MUSIC_CORS_ORIGINS=